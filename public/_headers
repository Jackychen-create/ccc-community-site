/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com https://cdn.discordapp.com; media-src 'self' blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.r2.cloudflarestorage.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.ecpay.com.tw

/assets/*
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

# 頁面本身也每次確認有沒有新版，免得舊頁面配到新程式
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/lab
  Cache-Control: no-cache

/admin
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-cache

/watch
  Cache-Control: no-cache

/watch.html
  Cache-Control: no-cache

/changelog.json
  Cache-Control: no-store


# 介紹頁（2026-11-20 起沒登入的人在首頁「/」看到的就是它，functions/index.js）
/start/*
  ! X-Robots-Tag
  Cache-Control: no-cache
